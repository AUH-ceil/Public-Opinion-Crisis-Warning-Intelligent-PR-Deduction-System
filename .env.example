# ============================================================
# agent11 环境变量配置模板
# 复制本文件为 .env 并填入真实值，.env 已被 .gitignore 排除
# ============================================================

# ==================== DeepSeek 大模型（必填） ====================
# 在 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=

# 模型选择（可不改，默认 deepseek-chat）
LLM_MODEL=deepseek-chat

# API地址（可不改）
LLM_BASE_URL=https://api.deepseek.com/v1

# ==================== Google 搜索（可选，填了能用 API 搜索） ====================
# Google Custom Search: https://programmablesearchengine.google.com/
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CX=your-search-engine-id

# SerpAPI（可选，在 https://serpapi.com 获取）
SERPAPI_KEY=

# ==================== MySQL 数据库 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=crisis_db

# ==================== Qdrant 向量库 ====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
